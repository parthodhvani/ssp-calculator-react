# WordPress base URL — no trailing slash
VITE_WP_API_URL=https://devwp1.websiteserverhost.biz/ssp-calculator

# Calculate page → /wp-json/wp/v2/pages/130
VITE_WP_CALCULATE_PAGE_ID=130

# Eligibility page → /wp-json/wp/v2/pages/149
VITE_WP_ELIGIBILITY_PAGE_ID=149

# Rules page → create WP page (slug: rules), then set the ID
# Example: VITE_WP_RULES_PAGE_ID=160
# VITE_WP_RULES_PAGE_ID=
VITE_WP_RULES_SLUG=rules

# Blog page → create WP page (slug: blog), then set the ID
# Example: VITE_WP_BLOG_PAGE_ID=161
# VITE_WP_BLOG_PAGE_ID=
VITE_WP_BLOG_SLUG=blog

# Contact page (ACF copy) → create WP page (slug: contact), then set the ID
# Example: VITE_WP_CONTACT_PAGE_ID=170
# VITE_WP_CONTACT_PAGE_ID=
VITE_WP_CONTACT_SLUG=contact

# Contact Form 7 — numeric form ID from edit URL (?post=123 → 123)
# Install CF7 + Flamingo; see wp-acf/CONTACT-CF7.md
# Example: VITE_WP_CF7_FORM_ID=123
# VITE_WP_CF7_FORM_ID=

# Optional slug fallbacks (only if page IDs are unset)
# VITE_WP_CALCULATE_SLUG=calculator-page
# VITE_WP_ELIGIBILITY_SLUG=eligibility
