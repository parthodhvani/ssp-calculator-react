# Base URL of your WordPress install (no trailing slash).
# The Calculate page fetches:
#   {VITE_WP_API_URL}/wp-json/wp/v2/pages?slug=calculate&_fields=id,slug,acf
# See wp-acf/ACF-INTEGRATION.md and wp-acf/acf-field-group.json for setup.
VITE_WP_API_URL=https://your-wp-site.com

# Optional — WP page slug for the Calculate page (default: calculate)
# VITE_WP_CALCULATE_SLUG=calculate
