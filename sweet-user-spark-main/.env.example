# WordPress base URL — no trailing slash
# (include the WP subdirectory if needed)
VITE_WP_API_URL=https://devwp1.websiteserverhost.biz/ssp-calculator

# Calculate page ID → fetches:
#   {VITE_WP_API_URL}/wp-json/wp/v2/pages/130
VITE_WP_CALCULATE_PAGE_ID=130

# Only used if VITE_WP_CALCULATE_PAGE_ID is unset
# VITE_WP_CALCULATE_SLUG=calculator-page
