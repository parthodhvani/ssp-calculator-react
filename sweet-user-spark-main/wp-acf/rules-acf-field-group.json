[
  {
    "key": "group_rules_page",
    "title": "Rules Page — Edit Content",
    "fields": [
      {
        "key": "field_rules_msg_welcome",
        "label": "How to use",
        "name": "",
        "type": "message",
        "message": "<div style=\"padding:12px 16px;background:#f0f6ff;border-left:4px solid #1e3a5f;border-radius:6px\"><p style=\"margin:0 0 8px\"><strong>Edit the Rules / reference page here.</strong></p><p style=\"margin:0;color:#444\">Tabs: Header → Rule cards → Bottom CTA. Create a WordPress page with slug <strong>rules</strong>, attach this field group, fill content, then set <code>VITE_WP_RULES_PAGE_ID</code> in React <code>.env</code>. Click <strong>Update</strong> after editing.</p></div>"
      },

      {
        "key": "field_rules_tab_header",
        "label": "① Page header",
        "type": "tab",
        "placement": "top"
      },
      {
        "key": "field_rules_header",
        "label": "Header",
        "name": "header",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {
            "key": "field_rules_kicker",
            "label": "Small kicker (above the title)",
            "name": "kicker",
            "type": "text",
            "default_value": "Reference · Dutch Civil Code",
            "instructions": "Example: Reference · Dutch Civil Code"
          },
          {
            "key": "field_rules_title",
            "label": "Page title",
            "name": "title",
            "type": "text",
            "default_value": "The rules we apply"
          },
          {
            "key": "field_rules_description",
            "label": "Description under the title",
            "name": "description",
            "type": "textarea",
            "rows": 3,
            "default_value": "Every number Recura shows you traces back to a specific article of Dutch law or a clause in your CAO. Here's the short version, in plain English."
          }
        ]
      },

      {
        "key": "field_rules_tab_sections",
        "label": "② Rule cards",
        "type": "tab"
      },
      {
        "key": "field_rules_msg_sections",
        "label": "",
        "name": "",
        "type": "message",
        "message": "<p style=\"margin:0;padding:8px 12px;background:#f8fafc;border-radius:4px\">Each row = one card on the website. Pick an icon, then fill kicker, title, body, and legal references.</p>"
      },
      {
        "key": "field_rules_sections",
        "label": "Rule sections",
        "name": "sections",
        "type": "repeater",
        "layout": "block",
        "min": 1,
        "max": 12,
        "button_label": "+ Add rule card",
        "sub_fields": [
          {
            "key": "field_rules_section_icon",
            "label": "Icon",
            "name": "icon",
            "type": "select",
            "choices": {
              "scale": "Scale (law / floor)",
              "clock": "Clock (time limits)",
              "alert": "Alert (exceptions)",
              "book": "Book (CAO / contract)"
            },
            "default_value": "scale",
            "return_format": "value",
            "wrapper": { "width": "30" }
          },
          {
            "key": "field_rules_section_kicker",
            "label": "Card kicker",
            "name": "kicker",
            "type": "text",
            "placeholder": "The floor",
            "wrapper": { "width": "70" }
          },
          {
            "key": "field_rules_section_title",
            "label": "Card title",
            "name": "title",
            "type": "text",
            "placeholder": "Article 7:629 — the 70% rule"
          },
          {
            "key": "field_rules_section_body",
            "label": "Card body",
            "name": "body",
            "type": "textarea",
            "rows": 4
          },
          {
            "key": "field_rules_section_refs",
            "label": "Legal references",
            "name": "refs",
            "type": "repeater",
            "layout": "table",
            "button_label": "+ Add reference",
            "sub_fields": [
              {
                "key": "field_rules_section_ref_text",
                "label": "Reference text",
                "name": "text",
                "type": "text",
                "placeholder": "Art. 7:629 lid 1"
              }
            ]
          }
        ]
      },

      {
        "key": "field_rules_tab_cta",
        "label": "③ Bottom CTA",
        "type": "tab"
      },
      {
        "key": "field_rules_cta",
        "label": "Call to action",
        "name": "cta",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {
            "key": "field_rules_cta_title",
            "label": "CTA title",
            "name": "title",
            "type": "text",
            "default_value": "Ready to see the numbers?"
          },
          {
            "key": "field_rules_cta_body",
            "label": "CTA body",
            "name": "body",
            "type": "textarea",
            "rows": 2,
            "default_value": "Run your own case through the calculator, or upload a policy to see whether it clears the statutory floor."
          },
          {
            "key": "field_rules_cta_primary_label",
            "label": "Primary button — text",
            "name": "primary_label",
            "type": "text",
            "default_value": "Open calculator",
            "wrapper": { "width": "50" }
          },
          {
            "key": "field_rules_cta_primary_link",
            "label": "Primary button — link",
            "name": "primary_link",
            "type": "text",
            "default_value": "/",
            "placeholder": "/",
            "wrapper": { "width": "50" }
          },
          {
            "key": "field_rules_cta_secondary_label",
            "label": "Secondary button — text",
            "name": "secondary_label",
            "type": "text",
            "default_value": "Analyse a policy",
            "wrapper": { "width": "50" }
          },
          {
            "key": "field_rules_cta_secondary_link",
            "label": "Secondary button — link",
            "name": "secondary_link",
            "type": "text",
            "default_value": "/policy-analyser",
            "placeholder": "/policy-analyser",
            "wrapper": { "width": "50" }
          }
        ]
      }
    ],
    "location": [
      [
        {
          "param": "page",
          "operator": "==",
          "value": "rules"
        }
      ]
    ],
    "menu_order": 0,
    "position": "acf_after_title",
    "style": "seamless",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": [
      "the_content",
      "excerpt",
      "discussion",
      "comments",
      "revisions",
      "slug",
      "author",
      "format",
      "featured_image",
      "categories",
      "tags",
      "send-trackbacks"
    ],
    "active": true,
    "show_in_rest": 1,
    "description": "Client-friendly content for the Rules page. Create WP page slug rules, attach this group, set VITE_WP_RULES_PAGE_ID. Frontend fetches /wp-json/wp/v2/pages/{id}."
  }
]
