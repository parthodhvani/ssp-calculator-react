            "key": "field_rules_linked_absence_days",
            "label": "Linked-absence window",
            "name": "linked_absence_days",
            "type": "number",
            "instructions": "If two absences are closer than this, they share one entitlement. Default: 28 days.",
            "default_value": 28,
            "append": "days"
          },
          {
