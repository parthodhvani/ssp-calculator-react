      {
        "key": "field_msg_rules",
        "label": "",
        "name": "",
        "type": "message",
        "message": "<div style=\"padding:12px 16px;background:#fff8e6;border-left:4px solid #c9a227;border-radius:6px\"><p style=\"margin:0 0 8px\"><strong>These numbers power the calculator.</strong></p><p style=\"margin:0 0 8px\">Change <strong>Year 1 sick pay</strong> from 100 → 75 and instantly:</p><ul style=\"margin:0;padding-left:18px\"><li>Blue “Your entitlement” card uses 75%</li><li>Sample card Year 1 box shows 75%</li><li>Result text becomes “Year 1 · 75% of gross”</li><li>The “How We Calculate” section below updates its steps, worked example, and FAQ automatically</li></ul><p style=\"margin:8px 0 0\">No code change. Click Update.</p></div>"
      },
      {
        "key": "field_rules",
        "label": "Statutory pay rules",
        "name": "rules",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {
            "key": "field_rules_year1_percent",
            "label": "Year 1 sick pay",
            "name": "year1_percent",
            "type": "number",
            "instructions": "% of gross monthly salary in year 1, applied directly to the entered salary. Used for maths + display.",
            "default_value": 100,
            "min": 0,
            "max": 100,
            "append": "%"
          },
          {
            "key": "field_rules_year2_percent",
            "label": "Year 2 sick pay",
            "name": "year2_percent",
            "type": "number",
            "instructions": "% of gross monthly salary in year 2, applied directly to the entered salary. Used for maths + display.",
            "default_value": 70,
            "min": 0,
            "max": 100,
            "append": "%"
          },
          {
            "key": "field_rules_max_weeks",
            "label": "Maximum entitlement",
            "name": "max_weeks",
            "type": "number",
            "instructions": "Usually 104 weeks (2 years).",
            "default_value": 104,
            "append": "weeks"
          },
          {
            "key": "field_rules_waiting_days",
            "label": "Waiting days (wachtdag)",
            "name": "waiting_days",
            "type": "number",
            "instructions": "Unpaid days at the start of sick leave. Default: 0.",
            "default_value": 0,
            "append": "days"
          },
