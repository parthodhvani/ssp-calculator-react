      {
        "key": "field_tab_rules",
        "label": "6. Pay Rules ⚡",
        "type": "tab"
      },
      {
        "key": "field_msg_rules",
        "label": "",
        "name": "",
        "type": "message",
        "message": "<div style=\"padding:10px 14px;background:#fff8e6;border-left:4px solid #c9a227;border-radius:4px\"><p style=\"margin:0 0 8px\"><strong>These numbers power the calculator maths.</strong></p><p style=\"margin:0 0 8px\">If you change <strong>Year 1 sick pay</strong> from 100 to 75:</p><ul style=\"margin:0;padding-left:18px\"><li>Monthly Year 1 pay becomes salary × 75%</li><li>The result text becomes “Year 1 · 75% of gross”</li></ul><p style=\"margin:8px 0 0\">No code change needed — click Update on this page.</p></div>"
      },
      {
        "key": "field_rules",
        "label": "Statutory pay rules",
        "name": "rules",
        "type": "group",
        "layout": "block",
        "sub_fields": [
          {
            "key": "field_rules_year1_percent",
            "label": "Year 1 sick pay",
            "name": "year1_percent",
            "type": "number",
            "instructions": "Percent of gross salary paid in year 1 of illness.",
            "default_value": 100,
            "min": 0,
            "max": 100,
            "append": "%",
            "wrapper": { "width": "50" }
          },
          {
            "key": "field_rules_year2_percent",
            "label": "Year 2 sick pay",
            "name": "year2_percent",
            "type": "number",
            "instructions": "Percent of gross salary paid in year 2 of illness.",
            "default_value": 70,
            "min": 0,
            "max": 100,
            "append": "%",
            "wrapper": { "width": "50" }
          },
          {
            "key": "field_rules_max_weeks",
            "label": "Maximum entitlement",
            "name": "max_weeks",
            "type": "number",
            "instructions": "Usually 104 weeks (2 years).",
            "default_value": 104,
            "append": "weeks",
            "wrapper": { "width": "33" }
          },
          {
            "key": "field_rules_waiting_days",
            "label": "Waiting days (wachtdag)",
            "name": "waiting_days",
            "type": "number",
            "instructions": "Unpaid days at the start of sick leave.",
            "default_value": 1,
            "append": "days",
            "wrapper": { "width": "33" }
          },
          {
            "key": "field_rules_linked_absence_days",
            "label": "Linked-absence window",
            "name": "linked_absence_days",
            "type": "number",
            "instructions": "If two absences are closer than this, they share one entitlement. Statutory default: 28 days.",
            "default_value": 28,
            "append": "days",
            "wrapper": { "width": "34" }
          },
          {
            "key": "field_rules_min_wage_monthly",
            "label": "Statutory minimum wage (monthly)",
            "name": "min_wage_monthly",
            "type": "number",
            "instructions": "Update when the Dutch government revises minimum wage (Jan / Jul).",
            "default_value": 2437,
            "prepend": "€",
            "append": "/ month"
          }
        ]
      },

